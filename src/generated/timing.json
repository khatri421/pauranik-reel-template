{
 "duration": 15.11,
 "title": "JAMBAVAN KI ICHCHHA · BHAAG 1",
 "blocks": 10,
 "mode": "line-per-block",
 "shots": [
  {
   "at": 0,
   "text": "Lanka ki yuddh-bhoomi shaant ho chuki thi."
  },
  {
   "at": 1.53,
   "text": "Par Jambavan ke mann mein ek ichchha baaki thi."
  },
  {
   "at": 3.08,
   "text": "Woh dheere-dheere Shri Ram ke paas pahunche."
  },
  {
   "at": 4.73,
   "text": "Haath jodkar bole, \"Prabhu,"
  },
  {
   "at": 6.13,
   "text": "ek baar aapse dwandva yuddh karna hai.\""
  },
  {
   "at": 7.73,
   "text": "Shri Ram ne muskurakar haath uthaya."
  },
  {
   "at": 9.13,
   "text": "\"Abhi nahi, Jambavan."
  },
  {
   "at": 10.78,
   "text": "Agle avatar mein ye ichchha poori karunga.\""
  },
  {
   "at": 12.28,
   "text": "Jambavan ne intezaar shuru kiya..."
  },
  {
   "at": 13.58,
   "text": "aur phir Dwarka mein Krishna aaye."
  }
 ],
